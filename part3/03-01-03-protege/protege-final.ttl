###  http://k.fc/onto/citydata#speed
<http://k.fc/onto/citydata#speed> rdf:type owl:DatatypeProperty ;
                                  rdfs:domain <http://k.fc/onto/citydata#TrafficStatus> ;
                                  rdfs:range xsd:decimal .


###  http://k.fc/onto/citydata#temperature
<http://k.fc/onto/citydata#temperature> rdf:type owl:DatatypeProperty ;
                                        rdfs:domain [ rdf:type owl:Class ;
                                                      owl:unionOf ( <http://k.fc/onto/citydata#WeatherForecast>
                                                                    <http://k.fc/onto/citydata#WeatherStatus>
                                                                  )
                                                    ] ;
                                        rdfs:range xsd:decimal ;
                                        rdfs:label "온도"@ko .


###  http://k.fc/onto/citydata#trafficIndex
<http://k.fc/onto/citydata#trafficIndex> rdf:type owl:DatatypeProperty ;
                                         rdfs:domain <http://k.fc/onto/citydata#TrafficStatus> ;
                                         rdfs:range xsd:string .


