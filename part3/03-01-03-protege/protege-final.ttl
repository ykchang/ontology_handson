@prefix : <http://www.semanticweb.org/user/ontologies/2026/4/untitled-ontology-11/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/user/ontologies/2026/4/untitled-ontology-11/> .

<http://www.semanticweb.org/user/ontologies/2026/4/untitled-ontology-11> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://k.fc/onto/citydata#hasArrivalInfo
<http://k.fc/onto/citydata#hasArrivalInfo> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://k.fc/onto/citydata#SubwayStation> ;
                                           rdfs:range <http://k.fc/onto/citydata#SubwayArrivalInfo> ;
                                           rdfs:label "도착 정보를 가짐"@ko .


###  http://k.fc/onto/citydata#hasBusinessCategoryStatus
<http://k.fc/onto/citydata#hasBusinessCategoryStatus> rdf:type owl:ObjectProperty ;
                                                      rdfs:domain <http://k.fc/onto/citydata#CommercialStatus> ;
                                                      rdfs:range <http://k.fc/onto/citydata#BusinessCategoryStatus> ;
                                                      rdfs:label "업종별 상태를 가짐"@ko .


###  http://k.fc/onto/citydata#hasCharger
<http://k.fc/onto/citydata#hasCharger> rdf:type owl:ObjectProperty .


###  http://k.fc/onto/citydata#hasEndNode
<http://k.fc/onto/citydata#hasEndNode> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <http://k.fc/onto/citydata#RoadSection> ;
                                       rdfs:range <http://k.fc/onto/citydata#Node> ;
                                       rdfs:label "종료 노드를 가짐"@ko .


###  http://k.fc/onto/citydata#hasFacility
<http://k.fc/onto/citydata#hasFacility> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <http://k.fc/onto/citydata#SubwayStation> ;
                                        rdfs:range <http://k.fc/onto/citydata#Facility> ;
                                        rdfs:label "편의시설을 가짐"@ko .


###  http://k.fc/onto/citydata#hasForecast
<http://k.fc/onto/citydata#hasForecast> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <http://k.fc/onto/citydata#Status> ;
                                        rdfs:range <http://k.fc/onto/citydata#Forecast> ;
                                        rdfs:label "예측 정보를 가짐"@ko .


###  http://k.fc/onto/citydata#hasStartNode
<http://k.fc/onto/citydata#hasStartNode> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <http://k.fc/onto/citydata#RoadSection> ;
                                         rdfs:range <http://k.fc/onto/citydata#Node> ;
                                         rdfs:label "시작 노드를 가짐"@ko .


###  http://k.fc/onto/citydata#hasStatus
<http://k.fc/onto/citydata#hasStatus> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <http://k.fc/onto/citydata#Area> ;
                                      rdfs:range [ rdf:type owl:Class ;
                                                   owl:unionOf ( <http://k.fc/onto/citydata#CommercialStatus>
                                                                 <http://k.fc/onto/citydata#PopulationStatus>
                                                                 <http://k.fc/onto/citydata#TrafficStatus>
                                                                 <http://k.fc/onto/citydata#WeatherStatus>
                                                               )
                                                 ] .


###  http://k.fc/onto/citydata#locatedIn
<http://k.fc/onto/citydata#locatedIn> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <http://k.fc/onto/citydata#TransportationPoint> ;
                                      rdfs:range <http://k.fc/onto/citydata#Area> .


#################################################################
#    Data properties
#################################################################

###  http://k.fc/onto/citydata#address
<http://k.fc/onto/citydata#address> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain [ rdf:type owl:Class ;
                                                  owl:unionOf ( <http://k.fc/onto/citydata#ChargingStation>
                                                                <http://k.fc/onto/citydata#ParkingLot>
                                                              )
                                                ] ;
                                    rdfs:range xsd:string .


###  http://k.fc/onto/citydata#capacity
<http://k.fc/onto/citydata#capacity> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <http://k.fc/onto/citydata#ParkingLot> ;
                                     rdfs:range xsd:integer .


###  http://k.fc/onto/citydata#chargerStatusValue
<http://k.fc/onto/citydata#chargerStatusValue> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <http://k.fc/onto/citydata#ChargerStatus> ;
                                               rdfs:range xsd:string .


###  http://k.fc/onto/citydata#chargerType
<http://k.fc/onto/citydata#chargerType> rdf:type owl:DatatypeProperty ;
                                        rdfs:domain <http://k.fc/onto/citydata#EVCharger> ;
                                        rdfs:range xsd:string .


###  http://k.fc/onto/citydata#congestionLevel
<http://k.fc/onto/citydata#congestionLevel> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain [ rdf:type owl:Class ;
                                                          owl:unionOf ( <http://k.fc/onto/citydata#PopulationForecast>
                                                                        <http://k.fc/onto/citydata#PopulationStatus>
                                                                      )
                                                        ] ;
                                            rdfs:range xsd:string .


###  http://k.fc/onto/citydata#congestionMessage
<http://k.fc/onto/citydata#congestionMessage> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <http://k.fc/onto/citydata#PopulationStatus> ;
                                              rdfs:range xsd:string ;
                                              rdfs:label "혼잡도 메시지"@ko .


###  http://k.fc/onto/citydata#distance
<http://k.fc/onto/citydata#distance> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <http://k.fc/onto/citydata#RoadSection> ;
                                     rdfs:range xsd:decimal .


###  http://k.fc/onto/citydata#femalePopulationRate
<http://k.fc/onto/citydata#femalePopulationRate> rdf:type owl:DatatypeProperty ;
                                                 rdfs:domain <http://k.fc/onto/citydata#PopulationStatus> ;
                                                 rdfs:range xsd:decimal ;
                                                 rdfs:label "여성 인구 비율"@ko .


###  http://k.fc/onto/citydata#forecastTime
<http://k.fc/onto/citydata#forecastTime> rdf:type owl:DatatypeProperty ;
                                         rdfs:range xsd:dateTime ;
                                         rdfs:label "예측 시각"@ko .


###  http://k.fc/onto/citydata#hasCharger
<http://k.fc/onto/citydata#hasCharger> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <http://k.fc/onto/citydata#ChargingStation> ;
                                       rdfs:range <http://k.fc/onto/citydata#EVCharger> .


###  http://k.fc/onto/citydata#humidity
<http://k.fc/onto/citydata#humidity> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <http://k.fc/onto/citydata#WeatherStatus> ;
                                     rdfs:range xsd:decimal ;
                                     rdfs:label "습도"@ko .


###  http://k.fc/onto/citydata#id
<http://k.fc/onto/citydata#id> rdf:type owl:DatatypeProperty ;
                               rdfs:range xsd:string .


###  http://k.fc/onto/citydata#isLimitedAccess
<http://k.fc/onto/citydata#isLimitedAccess> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain <http://k.fc/onto/citydata#ChargingStation> ;
                                            rdfs:range xsd:boolean .


###  http://k.fc/onto/citydata#isPaid
<http://k.fc/onto/citydata#isPaid> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <http://k.fc/onto/citydata#ParkingLot> ;
                                   rdfs:range xsd:boolean .


###  http://k.fc/onto/citydata#latitude
<http://k.fc/onto/citydata#latitude> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <http://k.fc/onto/citydata#TransportationPoint> ;
                                     rdfs:range xsd:decimal .


###  http://k.fc/onto/citydata#longitude
<http://k.fc/onto/citydata#longitude> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <http://k.fc/onto/citydata#TransportationPoint> ;
                                      rdfs:range xsd:decimal .


###  http://k.fc/onto/citydata#malePopulationRate
<http://k.fc/onto/citydata#malePopulationRate> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <http://k.fc/onto/citydata#PopulationStatus> ;
                                               rdfs:range xsd:decimal .


###  http://k.fc/onto/citydata#name
<http://k.fc/onto/citydata#name> rdf:type owl:DatatypeProperty ;
                                 rdfs:range xsd:string .


###  http://k.fc/onto/citydata#observationTime
<http://k.fc/onto/citydata#observationTime> rdf:type owl:DatatypeProperty ;
                                            rdfs:range xsd:dateTime .


###  http://k.fc/onto/citydata#output
<http://k.fc/onto/citydata#output> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <http://k.fc/onto/citydata#EVCharger> ;
                                   rdfs:range xsd:decimal .


###  http://k.fc/onto/citydata#populationMax
<http://k.fc/onto/citydata#populationMax> rdf:type owl:DatatypeProperty ;
                                          rdfs:domain [ rdf:type owl:Class ;
                                                        owl:unionOf ( <http://k.fc/onto/citydata#PopulationForecast>
                                                                      <http://k.fc/onto/citydata#PopulationStatus>
                                                                    )
                                                      ] ;
                                          rdfs:range xsd:integer .


###  http://k.fc/onto/citydata#populationMin
<http://k.fc/onto/citydata#populationMin> rdf:type owl:DatatypeProperty ;
                                          rdfs:domain [ rdf:type owl:Class ;
                                                        owl:unionOf ( <http://k.fc/onto/citydata#PopulationForecast>
                                                                      <http://k.fc/onto/citydata#PopulationStatus>
                                                                    )
                                                      ] ;
                                          rdfs:range xsd:integer .


###  http://k.fc/onto/citydata#precipitation
<http://k.fc/onto/citydata#precipitation> rdf:type owl:DatatypeProperty ;
                                          rdfs:domain [ rdf:type owl:Class ;
                                                        owl:unionOf ( <http://k.fc/onto/citydata#WeatherForecast>
                                                                      <http://k.fc/onto/citydata#WeatherStatus>
                                                                    )
                                                      ] ;
                                          rdfs:range xsd:string ;
                                          rdfs:label "강수량"@ko .


###  http://k.fc/onto/citydata#skyStatus
<http://k.fc/onto/citydata#skyStatus> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <http://k.fc/onto/citydata#WeatherForecast> ;
